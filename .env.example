# Copy to .env for local runs. On Render, add these as service environment
# variables. Do not set PORT on Render — Render injects it.

NODE_ENV=development
PORT=5000

# Replace this demo URI with your MongoDB Atlas connection string.
DATABASE_URL=mongodb+srv://naasrafulkhan_db_user:J7cIAJyz5v75edY1@university-management.v7pxppq.mongodb.net?retryWrites=true&w=majority

BCRYPT_SALT_ROUNDS=12
DEFAULT_PASS=changeme123

# Exact browser origin of the frontend, no trailing slash.
# Local: http://localhost:4173
# Render: https://your-frontend-service.onrender.com
FRONTEND_URL=http://localhost:4173

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRATION_TIME=1d
JWT_REFRESH_TOKEN_EXPIRATION_TIME=30d

# Seeded on first boot if no super admin exists.
SUPER_ADMIN_PASSWORD=superadmin123
SUPER_ADMIN_EMAIL=superadmin@mail.com
SUPER_ADMIN_ID=0001

